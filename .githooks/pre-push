#!/bin/sh
# Before pushing: the fast part of the CI gate (type check + unit tests).
# E2E runs in CI only (needs a web export and a browser).
# Skip in an emergency: git push --no-verify
set -e
echo "pre-push: type check…"
npx --no-install tsc --noEmit
echo "pre-push: unit tests…"
npx --no-install jest --ci --silent
