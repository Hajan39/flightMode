# EAS build ignore rules
# Keep in sync with .gitignore and exclude local agent/tooling folders.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
.env

# local AI/tooling folders (can contain symlinks not supported by EAS tar on Windows)
.agents/
.claude/
.vscode/
