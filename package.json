{
  "name": "flight-mode",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "update": "expo install --fix",
    "ota:preview": "node ./scripts/eas-update-from-changelog.js preview",
    "ota:production": "node ./scripts/eas-update-from-changelog.js production",
    "eas:build:android": "npx eas-cli build --platform android --profile production",
    "deploy:android": "npx eas-cli build --platform android --auto-submit --profile production",
    "deploy:internal": "npx eas-cli build --platform android --profile production --auto-submit-with-profile internal",
    "eas:submit:android": "npx eas-cli submit --platform android --profile production",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "expo": "~57.0.22",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-insights": "~57.0.17",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.3",
    "posthog-react-native": "^4.71.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "private": true
}
